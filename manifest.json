{
  "manifest_version": 3,
  "name": "Comment Filters for Webflow",
  "version": "1.0.0",
  "author": "Lavkush Maurya",
  "description": "Filter and sort comments in the Webflow Designer Comments panel by author, date, breakpoint, replies and more.",
  "homepage_url": "https://www.spiderflow.io/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.design.webflow.com/*", "https://webflow.com/design/*"],
      "js": ["comment-filter.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
